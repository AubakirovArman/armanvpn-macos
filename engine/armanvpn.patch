+# armanVPN local diagnostics
+
+The armanVPN integration adds a `GetDiagnostics` command to the existing authorized
+local command socket. It returns a process instance ID and the last 128 ordered,
+timestamped reason codes, including keepalive timeouts and gateway SA deletion.
+It contains no authentication data, certificates, packet contents or error text.
+It is memory-only and resets when the engine process restarts.
diff --git a/crates/snxcore/src/diagnostics.rs b/crates/snxcore/src/diagnostics.rs
new file mode 100644
index 0000000..03f4bc5
--- /dev/null
+++ b/crates/snxcore/src/diagnostics.rs
@@ -0,0 +1,178 @@
+use std::{
+    collections::VecDeque,
+    sync::{LazyLock, Mutex},
+};
+
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+const CAPACITY: usize = 128;
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum DiagnosticCode {
+    Connected,
+    Disconnected,
+    UserDisconnect,
+    TunnelError,
+    ControlError,
+    IkeExchangeTimeout,
+    IkeControlNetworkError,
+    IkeIntegrityFailed,
+    IkeMalformedPacket,
+    PeerRequestFailed,
+    OfficeModeLeaseLifetime,
+    OfficeModeRenewalStarted,
+    OfficeModeRenewalFailed,
+    IpsecRekeyFailed,
+    KeepaliveMissed,
+    KeepaliveTimeout,
+    GatewayDeletedSa,
+    IkeExpired,
+    SslTransportClosed,
+    SslKeepaliveTimeout,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct DiagnosticEvent {
+    pub sequence: u64,
+    pub at: DateTime<Utc>,
+    pub code: DiagnosticCode,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub value: Option<u64>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct DiagnosticSnapshot {
+    pub instance: Uuid,
+    pub events: Vec<DiagnosticEvent>,
+}
+
+struct Journal {
+    instance: Uuid,
+    sequence: u64,
+    events: VecDeque<DiagnosticEvent>,
+}
+
+impl Journal {
+    fn new() -> Self {
+        Self {
+            instance: Uuid::new_v4(),
+            sequence: 0,
+            events: VecDeque::new(),
+        }
+    }
+
+    fn record(&mut self, code: DiagnosticCode) {
+        self.record_value(code, None);
+    }
+
+    fn record_value(&mut self, code: DiagnosticCode, value: Option<u64>) {
+        self.sequence += 1;
+        self.events.push_back(DiagnosticEvent {
+            sequence: self.sequence,
+            at: Utc::now(),
+            code,
+            value,
+        });
+        if self.events.len() > CAPACITY {
+            self.events.pop_front();
+        }
+    }
+
+    fn snapshot(&self) -> DiagnosticSnapshot {
+        DiagnosticSnapshot {
+            instance: self.instance,
+            events: self.events.iter().cloned().collect(),
+        }
+    }
+}
+
+static JOURNAL: LazyLock<Mutex<Journal>> = LazyLock::new(|| Mutex::new(Journal::new()));
+
+pub fn record(code: DiagnosticCode) {
+    JOURNAL.lock().unwrap_or_else(|e| e.into_inner()).record(code);
+}
+
+pub fn snapshot() -> DiagnosticSnapshot {
+    JOURNAL.lock().unwrap_or_else(|e| e.into_inner()).snapshot()
+}
+
+pub fn record_value(code: DiagnosticCode, value: u64) {
+    JOURNAL
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .record_value(code, Some(value));
+}
+
+pub fn record_control_error(error: &anyhow::Error) {
+    record(control_error_code(error));
+}
+
+fn control_error_code(error: &anyhow::Error) -> DiagnosticCode {
+    if error.chain().any(|e| e.is::<tokio::time::error::Elapsed>()) {
+        DiagnosticCode::IkeExchangeTimeout
+    } else if error.chain().any(|e| e.is::<std::io::Error>()) {
+        DiagnosticCode::IkeControlNetworkError
+    } else if error.chain().any(|e| e.to_string().contains("integrity check failed")) {
+        DiagnosticCode::IkeIntegrityFailed
+    } else if error.chain().any(|e| {
+        let text = e.to_string();
+        text.contains("IKEv2 message shorter")
+            || text.contains("Not an IKEv2 message")
+            || text.contains("IKEv2 message claims")
+    }) {
+        DiagnosticCode::IkeMalformedPacket
+    } else {
+        DiagnosticCode::ControlError
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bounded_history_keeps_order_across_snapshots() {
+        let mut journal = Journal::new();
+        for _ in 0..CAPACITY + 5 {
+            journal.record(DiagnosticCode::KeepaliveMissed);
+        }
+        let before = journal.snapshot();
+        assert_eq!(before.events.len(), CAPACITY);
+        assert_eq!(before.events[0].sequence, 6);
+        journal.record(DiagnosticCode::KeepaliveTimeout);
+        let after = journal.snapshot();
+        assert_eq!(before.instance, after.instance);
+        assert_eq!(after.events.last().unwrap().code, DiagnosticCode::KeepaliveTimeout);
+        assert!(after.events.last().unwrap().sequence > before.events.last().unwrap().sequence);
+        assert_ne!(Journal::new().instance, journal.instance);
+    }
+
+    #[test]
+    fn wire_events_have_only_fixed_codes_and_metadata() {
+        let mut journal = Journal::new();
+        journal.record(DiagnosticCode::GatewayDeletedSa);
+        let json = serde_json::to_value(journal.snapshot()).unwrap();
+        let event = json["events"][0].as_object().unwrap();
+        assert_eq!(event.len(), 3);
+        assert_eq!(event["code"], "gateway_deleted_sa");
+        assert!(event.contains_key("sequence"));
+        assert!(event.contains_key("at"));
+    }
+
+    #[test]
+    fn error_details_never_enter_the_diagnostic_payload() {
+        let error = anyhow::anyhow!("SK payload integrity check failed: secret-test-material");
+        assert_eq!(control_error_code(&error), DiagnosticCode::IkeIntegrityFailed);
+        let mut journal = Journal::new();
+        journal.record(control_error_code(&error));
+        let json = serde_json::to_string(&journal.snapshot()).unwrap();
+        assert!(!json.contains("secret-test-material"));
+        assert_eq!(
+            control_error_code(&anyhow::anyhow!("unrecognized test error")),
+            DiagnosticCode::ControlError
+        );
+    }
+}
